# Zerodha Kite Connect API Credentials
KITE_API_KEY=your_api_key_here
KITE_API_SECRET=your_api_secret_here

# Automated Headless TOTP Login Credentials
KITE_USER_ID=your_zerodha_user_id
KITE_PASSWORD=your_zerodha_password
KITE_TOTP_KEY=your_32_character_base32_totp_key

# Cached Daily Access Token (auto-updated by login flow)
KITE_ACCESS_TOKEN=

# Optional Telegram Alert Notifier
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Strangle Strategy Enhancements
STRANGLE_LOTS=10
STRANGLE_MORNING_FILTER=true
STRANGLE_MORNING_FILTER_PCT=0.60
STRANGLE_STRIKE_MODE=ATR
STRANGLE_ATR_MULTIPLIER=1.25
STRANGLE_TARGET_PRICE=30.0

# Stock Futures Strategy Desk
STOCK_FUTURES_MODE=PAPER
STOCK_FUTURES_LOTS=2
STOCK_FUTURES_MAX_CONCURRENT_POSITIONS=2

# MCX SILVERM Evening Combo 2A Barbell Setup (LIVE)
SILVER_MODE=LIVE
SILVER_STRATEGY_MODE=BARBELL
SILVER_LOTS=2
SILVER_STRIKE_MODE=ATR
SILVER_ATR_PERIOD=14
SILVER_ATR_MULTIPLIER=0.75
SILVER_VWAP_ENTRY=true
SILVER_VWAP_CUTOFF=21:45
SILVER_PORTFOLIO_SL_PCT=0.25
SILVER_MAX_DTE_DAYS=10
SILVER_BUYER_ENTRY_START=18:00
SILVER_BUYER_ENTRY_CUTOFF=20:00
SILVER_BUYER_MAX_DTE_DAYS=10
SILVER_BUYER_MIN_ATR_PCT=3.0
SILVER_BUYER_SL_PCT=0.30
SILVER_BUYER_TARGET_PCT=0.60
SILVER_BUYER_TRAIL_BE_PCT=0.25


